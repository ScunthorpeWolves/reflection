<!doctype html>
<html lang="en"><head><script src="/_sdk/telemetry_sdk.js"></script>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JLC Scunthorpe Wolves Reflection Log</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
  <script src="/_sdk/data_sdk.js"></script>
  <script src="/_sdk/editing_sdk.js"></script>
  <style>
    :root { --gold: #d4a574; --gold-dark: #a0773d; --accent-line: #2a2a2a; --bg-light: #f8f6f1; --bg-card: #ffffff; }
    body { font-family: 'DM Sans', sans-serif; }
    .session-option input { position: absolute; opacity: 0; pointer-events: none; }
    .session-option span { display: flex; align-items: center; justify-content: center; min-height: 48px; border-radius: 12px; border: 1px solid var(--accent-line); background: #ffffff; color: #1a1a1a; cursor: pointer; font-weight: 700; transition: transform .12s, border-color .2s, background .2s; user-select: none; }
    .session-option input:checked + span { background: linear-gradient(180deg, var(--gold), var(--gold-dark)); color: #ffffff; border-color: transparent; box-shadow: 0 8px 20px rgba(212,165,116,0.25); }
    .session-option span:hover { transform: translateY(-1px); }
    .field-error { color: #d32f2f; font-size: 0.75rem; min-height: 1rem; }
    select, textarea { width: 100%; border: 1px solid var(--accent-line); border-radius: 10px; background: #ffffff; color: #1a1a1a; padding: 10px 12px; font: inherit; outline: none; transition: border-color .2s, box-shadow .2s; }
    select { color-scheme: light; }
    select::placeholder { color: #999999; }
    textarea::placeholder { color: #999999; }
    select:focus, textarea:focus { border-color: var(--gold); box-shadow: 0 0 0 3px rgba(212,165,116,0.2); }
    select option { background: #ffffff; color: #1a1a1a; padding: 8px 12px; }
    select option:checked { background: linear-gradient(180deg, var(--gold), var(--gold-dark)); color: #ffffff; }
    textarea { min-height: 140px; resize: vertical; line-height: 1.5; }
    .spinner { width: 14px; height: 14px; border-radius: 999px; border: 1px solid #d4a574; border-right-color: transparent; animation: spin .8s linear infinite; display: inline-block; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js" type="text/javascript"></script>
  <script src="/_sdk/resizing_sdk.js" type="text/javascript"></script>
 </head>
 <body data-template-id="__page-root" class="min-h-screen flex items-start justify-center px-4 py-6" style="background: #f8f6f1;">
  <main class="w-full max-w-[560px] rounded-[28px] overflow-hidden" style="background: #ffffff; border: 3px solid #2a2a2a; box-shadow: 0 12px 40px rgba(0,0,0,0.12);">
   <header class="p-7 pb-6 text-center" style="border-bottom: 3px solid #2a2a2a; background: #f8f6f1;">
    
    <img data-template-id="wolves-logo-primary" class="canva-image mx-auto mb-5" style="width: 140px; height: 140px; object-fit: contain;" src="https://lh3.googleusercontent.com/d/1aZeHveXcf6ykzbrVZJPhIRHBQTZlzbaW" alt="JLC Scunthorpe Wolves Logo">
    
    <div data-template-id="club-badge" class="canva-tag inline-flex items-center justify-center gap-2 px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider mb-3" style="background: rgb(42, 42, 42); color: rgb(212, 165, 116); border: 2px solid rgb(212, 165, 116); font-weight: 400; font-style: normal; font-size: 16px;">JLC Scunthorpe Wolves Basketball Club</div>
    <h1 data-template-id="page-title" class="canva-text text-4xl font-bold tracking-tight mb-2" style="color: rgb(42, 42, 42); font-weight: 700; font-style: normal; font-size: 32px;">Reflection Log</h1>
    </header>
   <section class="p-6">
    <article class="rounded-[20px] p-6 mb-6 text-center" style="background: #f8f6f1; border: 2px solid #2a2a2a;">
     <h2 data-template-id="info-heading" class="canva-text text-lg font-bold mb-2" style="color: rgb(42, 42, 42); font-weight: 700; font-style: normal; font-size: 24px;">How to use</h2>
     <p data-template-id="info-text" class="canva-text text-sm leading-relaxed" style="color: rgb(26, 26, 26); font-weight: 400; font-style: normal; font-size: 16px;">Select your name from the dropdown, choose whether this was a Practice session or a Game, then write a short reflection on what went well and what you can improve. Hit Submit and you're done!</p>
    </article>
    <article class="rounded-[20px] p-6 text-center" style="background: #ffffff; border: 2px solid #2a2a2a;">
     <h2 data-template-id="form-heading" class="canva-text text-lg font-bold mb-4" style="color: rgb(42, 42, 42); font-weight: 700; font-style: normal; font-size: 24px;">Submit a reflection</h2>
     <form id="reflection-form" novalidate="" class="grid gap-4">
      <div><label data-template-id="label-player" for="player-select" class="canva-text block text-sm font-bold mb-2" style="color: rgb(42, 42, 42); font-weight: 700; font-style: normal; font-size: 16px;">Player Name</label> <select id="player-select" required=""><option value="">Select your name</option><option>Richard Adewunmi</option><option>Alfie Baker</option><option>Jai Bhullar</option><option>Charlie Cockram</option><option>Kuzey Cagin Erol</option><option>Opi Etteh</option><option>Oliver Geddes</option><option>Harrison Kendrick</option><option>Cyprian Kaluga</option><option>Thomas Kaluga</option><option>Harry Scott-Ward</option><option>Fin Smith</option><option>Kajetan Smolinski</option><option>Tomas Stackevicius</option><option>Louix Turner</option><option>Will Usher</option><option>Laurence Evangelista</option></select>
       <div class="field-error" id="err-player"></div>
      </div>
      <div><label data-template-id="label-session" class="canva-text block text-sm font-bold mb-2" style="color: rgb(42, 42, 42); font-weight: 700; font-style: normal; font-size: 16px;">Session Type</label>
       <div class="grid grid-cols-2 gap-3" role="radiogroup" aria-label="Session Type"><label class="session-option relative"><input type="radio" name="sessionType" value="Practice"><span>Practice</span></label> <label class="session-option relative"><input type="radio" name="sessionType" value="Game"><span>Game</span></label>
       </div>
       <div class="field-error" id="err-session"></div>
      </div>
      <div><label data-template-id="label-reflection" for="reflection-text" class="canva-text block text-sm font-bold mb-2" style="color: rgb(42, 42, 42); font-weight: 700; font-style: normal; font-size: 16px;">Your Reflection</label> <textarea id="reflection-text" placeholder="Please use this box to reflect on your own performance or attitude, you may also wish to recognise a teammate for their performance or attitude." required=""></textarea>
       <div class="field-error" id="err-reflection"></div>
      </div>
      <div class="flex items-center justify-center gap-3 flex-wrap"><button data-template-id="submit-btn" type="submit" class="canva-button rounded-[14px] px-6 py-3 font-extrabold text-[15px] transition hover:-translate-y-0.5" style="box-shadow: rgba(212, 165, 116, 0.2) 0px 8px 18px; background: linear-gradient(rgb(212, 165, 116), rgb(160, 119, 61)); color: rgb(255, 255, 255); font-weight: 800; font-style: normal; font-size: 16px;">Submit Reflection</button>
       <div id="status-msg" class="text-sm font-semibold" aria-live="polite"></div>
      </div>
      <p data-template-id="helper-text" class="canva-text text-xs opacity-70" style="color: rgb(26, 26, 26); font-weight: 400; font-style: normal; font-size: 16px;">All fields are required. Your name is remembered on this device for convenience.</p>
     </form>
    </article>
   </section>
   <footer class="px-6 py-5 text-center" style="border-top: 3px solid #2a2a2a; background: #f8f6f1;">
    <p data-template-id="footer-note" class="canva-text text-xs" style="color: rgb(42, 42, 42); font-weight: 400; font-style: normal; font-size: 16px;">JLC Scunthorpe Wolves 🐺</p>
   </footer>
  </main>
  <script>
    // EMBEDDED GOOGLE APPS SCRIPT WEB APP URL
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbx0Ny0BPzkx05E8rQ76qCMvrC1gZh6JOyG7gntyj2BdMG2bxYMFaBjNBdhc8NULIIey/exec';

    const STORAGE_KEY = 'jlc-wolves-last-player';
    const form = document.getElementById('reflection-form');
    const playerSelect = document.getElementById('player-select');
    const reflectionText = document.getElementById('reflection-text');
    const statusEl = document.getElementById('status-msg');
    const submitBtn = form.querySelector('[type="submit"]');

    try { const s = localStorage.getItem(STORAGE_KEY); if (s) playerSelect.value = s; } catch(e) {}
    playerSelect.addEventListener('change', () => { try { localStorage.setItem(STORAGE_KEY, playerSelect.value); } catch(e) {} });

    function getSessionType() { const c = document.querySelector('input[name="sessionType"]:checked'); return c ? c.value : ''; }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      ['err-player','err-session','err-reflection'].forEach(id => document.getElementById(id).textContent = '');
      statusEl.textContent = '';

      let valid = true;
      if (!playerSelect.value) { document.getElementById('err-player').textContent = 'Please select your name.'; valid = false; }
      if (!getSessionType()) { document.getElementById('err-session').textContent = 'Please choose Practice or Game.'; valid = false; }
      if (!reflectionText.value.trim()) { document.getElementById('err-reflection').textContent = 'Please write a reflection.'; valid = false; }
      if (!valid) return;

      submitBtn.disabled = true;
      statusEl.style.color = '#d4a574';
      statusEl.innerHTML = '<span class="spinner"></span> Sending your reflections…';

      const payload = {
        'Submission ID': `SUB-${Date.now()}`,
        'Timestamp': new Date().toISOString(),
        'Name': playerSelect.value,
        'Team or Group': getSessionType(),
        'Submission Details': reflectionText.value.trim()
      };

      try {
        const response = await fetch(SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors', // Necessary for sending data to Google Apps Script externally
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        statusEl.style.color = '#2e7d32';
        statusEl.textContent = 'Reflections sent to coaching staff! 🏀';
        reflectionText.value = '';
      } catch (error) {
        statusEl.style.color = '#d32f2f';
        statusEl.textContent = 'Something went wrong saving to the sheet. Please try again.';
        console.error('Google Sheet Error:', error);
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</body></html>
